/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-YgkvVD/xlS5QFAqSOcjJrduJ7P0B41bnT3gquf7bLls=' 'sha256-ajpytro0BizEF6KeCRrVFpbZ3ogTubZv1/DPr5PrXns='; style-src 'self' 'unsafe-inline'; img-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
/assets/*
  Cache-Control: public, max-age=86400
/downloads/*
  Cache-Control: no-store
/updates/*
  Cache-Control: no-store
  X-Robots-Tag: noindex
/objects/*
  Cache-Control: public, max-age=31536000, immutable
  X-Robots-Tag: noindex

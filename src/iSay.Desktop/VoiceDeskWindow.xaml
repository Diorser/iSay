<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:iSay.Desktop" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="iSay.Desktop.VoiceDeskWindow" Title="{local:L T001}" Icon="Assets/iSay.ico" Width="1100" Height="760" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="White" Foreground="#20272B" FontFamily="Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/界面资源.xaml" />
                <ResourceDictionary Source="Themes/整页滚动.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:HistoryPreviewConverter x:Key="HistoryPreview" />
            <local:NotNullConverter x:Key="NotNull" />
            <Style x:Key="HistoryCopyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="HistoryMoreButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="Padding" Value="6,0" />
            </Style>
            <Style x:Key="HelpButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" />
                <Setter Property="MinWidth" Value="22" /><Setter Property="MinHeight" Value="22" />
                <Setter Property="Padding" Value="0" /><Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" CornerRadius="11" BorderBrush="{StaticResource AccentBorder}" BorderThickness="1" Background="White"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{StaticResource AccentSoft}" /><Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="VocabularyList" TargetType="ListBox">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinHeight" Value="88" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                                <ScrollViewer Focusable="False" CanContentScroll="True" Padding="0">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F0FAF6" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TokenAction" TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Foreground" Value="#68776F" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="TokenList" TargetType="ListBox">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <local:AdaptiveTokenPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter Margin="0,2,0,0" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,5,6,5" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Token" Background="#F7FCFA" BorderBrush="#D9E9E3" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Token" Property="Background" Value="{StaticResource AccentSoft}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Token" Property="Background" Value="{StaticResource AccentSoft}" />
                                                <Setter TargetName="Token" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Token" Property="BorderBrush" Value="{StaticResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="WordToken">
                <Grid ToolTip="{Binding Word}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{local:L T002}" Tag="edit" Click="OnWordMenuClick" />
                            <MenuItem Header="{local:L T003}" Tag="speak" Click="OnWordMenuClick" />
                            <MenuItem Header="{local:L T004}" Tag="prefer" Click="OnWordMenuClick" />
                            <Separator />
                            <MenuItem Header="{local:L T005}" Tag="delete" Click="OnWordMenuClick" />
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="★" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding Preferred, Converter={StaticResource BooleanVisibility}}" DockPanel.Dock="Left" />
                            <TextBlock Text="{Binding Word}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                    </StackPanel>
                    <Button Content="×" Style="{StaticResource TokenAction}" ToolTip="{local:L T006}" AutomationProperties.Name="{local:L T005}" Click="OnWordDeleteClick" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="LearnedToken">
                <Grid ToolTip="{Binding Detail}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding KeepLabel}" Tag="keep" Click="OnLearningMenuClick" />
                            <MenuItem Header="{local:L T003}" Tag="speak" Click="OnLearningMenuClick" />
                            <MenuItem Tag="toggle" Click="OnLearningMenuClick">
                                <MenuItem.Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{local:L T007}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Origin}" Value="ignored">
                                                <Setter Property="Header" Value="{local:L T008}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Origin}" Value="keyboard">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </MenuItem.Style>
                            </MenuItem>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="✓" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="{Binding IsSaved, Converter={StaticResource BooleanVisibility}}" ToolTip="{local:L T009}" DockPanel.Dock="Right" />
                            <TextBlock Text="{Binding Word}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0" />
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding FrequencyLabel}" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="{Binding HasFrequency, Converter={StaticResource BooleanVisibility}}" ToolTip="{local:L T010}" />
                    <Button Click="OnLearningTokenClick" Grid.Column="2" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TokenAction}">
                                <Setter Property="Content" Value="×" />
                                <Setter Property="ToolTip" Value="{local:L T011}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Origin}" Value="ignored">
                                        <Setter Property="Content" Value="↶" />
                                        <Setter Property="ToolTip" Value="{local:L T008}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Origin}" Value="keyboard">
                                        <Setter Property="Content" Value="+" />
                                        <Setter Property="ToolTip" Value="{local:L T012}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </DataTemplate>
            <Style x:Key="NavItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="#20272B" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="NavSurface" Background="Transparent" CornerRadius="7" Margin="12,2" MinHeight="44">
                                <Grid>
                                    <Border x:Name="NavMarker" Width="3" Height="18" Background="{StaticResource Accent}" CornerRadius="1.5" HorizontalAlignment="Left" Visibility="Collapsed" />
                                    <ContentPresenter x:Name="NavLabel" ContentSource="Header" VerticalAlignment="Center" Margin="15,0,8,0" TextElement.Foreground="#646E74" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="NavSurface" Property="Background" Value="{StaticResource AccentSoft}" />
                                    <Setter TargetName="NavMarker" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="NavLabel" Property="TextElement.Foreground" Value="{StaticResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter TargetName="NavSurface" Property="Opacity" Value="0.78" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="NavSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter TargetName="NavSurface" Property="BorderThickness" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NavTabs" TargetType="TabControl">
                <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#F4F9F7" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Margin="26,27,0,31">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="Assets/iSay.png" Width="34" Height="34" Margin="0,0,11,0" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,34,34" RadiusX="8" RadiusY="8" /></Image.Clip></Image>
                                                <TextBlock Text="iSay" FontFamily="Segoe UI" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Margin="25,24,22,22">
                                            <TextBlock Text="{local:L T013}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                                            <Border Background="White" BorderBrush="#DCE1E3" BorderThickness="1" CornerRadius="5" Padding="9,3" HorizontalAlignment="Left" MaxWidth="137">
                                                <TextBlock Text="{Binding AppliedHotkeyDisplay}" FontFamily="Segoe UI" FontSize="12" TextWrapping="Wrap" />
                                            </Border>
                                            <TextBlock Text="{Binding AppliedGestureLabel}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            <TextBlock Text="{local:L T014}" Style="{StaticResource Hint}" Margin="0,14,0,0" />
                                            <TextBlock Text="{Binding ApplicationVersion}" Foreground="#9CA3A8" FontSize="11" Margin="0,7,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <ItemsPresenter />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Grid Grid.Column="1" Margin="{TemplateBinding Padding}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="36,28,40,0" TextElement.Foreground="#20272B" />
                                    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Style="{StaticResource Hint}" Margin="36,12,40,16" ToolTip="{Binding StatusText}" MaxHeight="38" x:Name="GlobalStatusText" />
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SelectedIndex" Value="1">
                                    <Setter TargetName="PART_SelectedContentHost" Property="Margin" Value="0" />
                                    <Setter TargetName="GlobalStatusText" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="SelectedIndex" Value="2">
                                    <Setter TargetName="PART_SelectedContentHost" Property="Margin" Value="0" />
                                    <Setter TargetName="GlobalStatusText" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="NavigationTabs" Grid.RowSpan="2" Style="{StaticResource NavTabs}" KeyboardNavigation.TabNavigation="Continue">
            <TabItem AutomationProperties.Name="{local:L T015}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" FontSize="16" Margin="0,0,11,0" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(TextElement.Foreground)}" />
                        <TextBlock Text="{local:L T015}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(TextElement.Foreground)}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="130" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:L T015}" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding AppliedOutputHint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding AppliedOutputHint}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,15,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="" FontSize="23" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{local:L T016}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Text" Value="{local:L T017}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Text" Value="{local:L T018}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding RecordingElapsed}" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource Muted}" Margin="12,3,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding EngineStatusText}" Style="{StaticResource Hint}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding EngineStatusText}" />
                            <local:AudioWaveform Level="{Binding MicrophoneLevel}" IsActive="{Binding IsRecording}" WaveBrush="{StaticResource Accent}" Width="160" Height="23" HorizontalAlignment="Left" Margin="0,7,0,0">
                                <local:AudioWaveform.Style>
                                    <Style TargetType="local:AudioWaveform">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:AudioWaveform.Style>
                            </local:AudioWaveform>
                        </StackPanel>
                        <Button Grid.Column="2" Tag="toggle-recording" Click="OnActionClick" Style="{StaticResource PrimaryButton}" MinWidth="126" MinHeight="42" IsEnabled="{Binding CanStartOrStop}" VerticalAlignment="Center">
                            <Button.Content>
                                <TextBlock Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{local:L T019}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <Setter Property="Text" Value="{local:L T020}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="Text" Value="{local:L T021}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="43" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TabControl x:Name="TranscriptTabs" Style="{StaticResource SectionTabs}" Margin="22,0,0,0">
                                    <TabItem Header="{Binding TranscriptHeading}">
                                        <TextBox x:Name="ResultTranscriptBox" Style="{StaticResource TranscriptEditor}" Margin="-22,-20,0,0" Text="{Binding TranscriptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding TranscriptHeading}" />
                                    </TabItem>
                                    <TabItem Header="{local:L T022}">
                                        <TextBox x:Name="RawTranscriptBox" Style="{StaticResource TranscriptEditor}" Margin="-22,-20,0,0" Text="{Binding RawText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:L N001}" />
                                    </TabItem>
                                </TabControl>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,7,12,0">
                                    <Button Content="{local:L T023}" Tag="retry-formatting" Click="OnActionClick" Style="{StaticResource TextButton}" IsEnabled="{Binding CanReformat}" Margin="0,0,6,0" />
                                    <Button Content="{local:L T024}" Click="OnCopyTranscriptClick" MinWidth="62">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="IsEnabled" Value="{Binding CanCopyTranscript}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=TranscriptTabs, Path=SelectedIndex}" Value="1">
                                                        <Setter Property="IsEnabled" Value="{Binding CanCopyRaw}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="15,40,15,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasTranscript}" Value="False" />
                                                        <Condition Binding="{Binding ElementName=TranscriptTabs, Path=SelectedIndex}" Value="0" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasRawText}" Value="False" />
                                                        <Condition Binding="{Binding ElementName=TranscriptTabs, Path=SelectedIndex}" Value="1" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="M0,12 L0,20 M8,6 L8,26 M16,0 L16,32 M24,8 L24,24 M32,13 L32,19" Stroke="#B2C6BD" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" Width="32" Height="32" Margin="0,0,0,19" />
                                    <TextBlock Text="{local:L T025}" FontSize="16" HorizontalAlignment="Center" />
                                    <TextBlock Text="{local:L T026}" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,9,0,0" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FormattingSummary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                <Setter Property="Text" Value="{Binding FormattingSummary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFormatting}" Value="True">
                                                        <Setter Property="Text" Value="{local:L T027}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

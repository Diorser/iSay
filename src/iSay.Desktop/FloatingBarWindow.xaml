<Window x:Class="iSay.Desktop.FloatingBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:iSay.Desktop"
        Title="{local:L T224}" Icon="Assets/iSay.ico" Width="144" Height="48" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        FontFamily="Microsoft YaHei UI" MouseLeftButtonDown="OnBarMouseDown">
    <Border x:Name="Capsule" Background="#081714" BorderBrush="#285348" BorderThickness="1" CornerRadius="20" Padding="13,7" Margin="4"
            ToolTip="{local:L T225}" ToolTipService.ShowDuration="6000">
        <Grid>
            <local:AudioWaveform x:Name="RecordingWave" Level="{Binding MicrophoneLevel}" IsActive="False" WaveBrush="#28E3B8"
                                 Width="104" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <StackPanel x:Name="StatePanel" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="StateIcon" Text="···" FontFamily="Segoe UI" Foreground="#A5B2BD" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StateLabel" Text="{local:L T226}" Foreground="#DCE5EB" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

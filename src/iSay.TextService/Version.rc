#include <windows.h>
#pragma code_page(65001)

// 原生组件版本独立写入 PE 资源，便于核验宿主实际加载的版本。
1 VERSIONINFO
 FILEVERSION 0,9,7,0
 PRODUCTVERSION 0,9,7,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "iSay\0"
            VALUE "FileDescription", "iSay 语音组合输入组件\0"
            VALUE "FileVersion", "0.9.7.0\0"
            VALUE "InternalName", "iSay.TextService\0"
            VALUE "OriginalFilename", "iSay.TextService.dll\0"
            VALUE "ProductName", "iSay\0"
            VALUE "ProductVersion", "0.9.7.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

